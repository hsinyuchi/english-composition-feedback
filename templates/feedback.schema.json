{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","assignment","rubric_source","rubric_url","rubric_checked","students"],
  "properties":{
    "schema_version":{"const":"4.0"},
    "assignment":{"type":"string","minLength":1},
    "assignment_en":{"type":"string","minLength":1},
    "rubric_source":{"type":"string","minLength":1},
    "rubric_url":{"type":"string","pattern":"^https://www\\.ceec\\.edu\\.tw/"},
    "rubric_checked":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "students":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/student"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1},
    "bilingual":{"type":"object","additionalProperties":false,"required":["en","zh"],"properties":{"en":{"$ref":"#/$defs/text"},"zh":{"$ref":"#/$defs/text"}}},
    "score":{"type":"object","additionalProperties":false,"required":["label","value","max","reason"],"properties":{"label":{"$ref":"#/$defs/text"},"value":{"type":"number","minimum":0},"max":{"type":"number","exclusiveMinimum":0},"reason":{"$ref":"#/$defs/text"}}},
    "task":{"type":"object","additionalProperties":false,"required":["instruction","lines"],"properties":{"instruction":{"$ref":"#/$defs/text"},"instruction_en":{"$ref":"#/$defs/text"},"lines":{"type":"integer","minimum":3,"maximum":5}}},
    "sentence":{"type":"object","additionalProperties":false,"required":["id","original","basic","notes","advanced"],"properties":{"id":{"type":"integer","minimum":1},"original":{"$ref":"#/$defs/text"},"basic":{"$ref":"#/$defs/text"},"notes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"advanced":{"$ref":"#/$defs/text"}}},
    "annotation":{"type":"object","additionalProperties":false,"required":["x","y","width","label","text","operation","target"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"width":{"type":"number","exclusiveMinimum":0,"maximum":1},"label":{"enum":["Sp","G","W","P"]},"text":{"type":"string"},"operation":{"enum":["insert","replace","delete"]},"target":{"type":"array","prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"items":false,"minItems":3,"maxItems":3}}},
    "rewrite":{"type":"object","additionalProperties":false,"required":["sentence_id","original","alternative","note"],"properties":{"sentence_id":{"type":"integer","minimum":1},"original":{"$ref":"#/$defs/text"},"alternative":{"$ref":"#/$defs/text"},"note":{"$ref":"#/$defs/text"}}},
    "error":{"type":"object","additionalProperties":false,"required":["sentence_id","category","original","correction","reason"],"properties":{"sentence_id":{"type":"integer","minimum":1},"category":{"enum":["Sp","G","W","P"]},"original":{"$ref":"#/$defs/text"},"correction":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"}}},
    "student":{
      "type":"object","additionalProperties":false,
      "required":["id","class","seat","name","paragraphs","reported_count","scores","deduction","deduction_reason","full_comment","tasks","reflections","sentences","models","errors","uncertainties","focus_original","optional_rewrites"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},"class":{"$ref":"#/$defs/text"},"seat":{"type":"integer","minimum":1},"name":{"$ref":"#/$defs/text"},
        "paragraphs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"reported_count":{"type":["integer","null"],"minimum":0},
        "scan":{"type":"string"},"annotations":{"type":"array","items":{"$ref":"#/$defs/annotation"}},
        "focus_original":{"$ref":"#/$defs/text"},
        "optional_rewrites":{"type":"array","maxItems":5,"items":{"$ref":"#/$defs/rewrite"}},
        "pdf_filename":{"type":"string","pattern":"^[^/\\\\]+\\.pdf$"},
        "scores":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/score"}},"deduction":{"type":"number","minimum":0},"deduction_reason":{"$ref":"#/$defs/text"},
        "short_comment":{"$ref":"#/$defs/bilingual"},"full_comment":{"$ref":"#/$defs/bilingual"},
        "tasks":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/task"}},
        "reflections":{"type":"array","minItems":2,"maxItems":3,"items":{"$ref":"#/$defs/text"}},
        "reflections_en":{"type":"array","minItems":2,"maxItems":3,"items":{"$ref":"#/$defs/text"}},
        "sentences":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sentence"}},
        "models":{"type":"object","additionalProperties":false,"required":["basic","advanced"],"properties":{"basic":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/bilingual"}},"advanced":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/bilingual"}}}},
        "errors":{"type":"array","items":{"$ref":"#/$defs/error"}},"uncertainties":{"type":"array","items":{"$ref":"#/$defs/text"}}
      }
    }
  }
}
